{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "c89e76dd2e1e930102199c59c32352b269ee388d",
  "separate-pull-requests": true,
  "always-update": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    "cli": {
      "release-type": "python",
      "component": "cli",
      "package-name": "qtizen",
      "changelog-path": "CHANGELOG.md"
    },
    "launcher": {
      "release-type": "simple",
      "component": "launcher",
      "package-name": "qtizen-launcher",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "xml",
          "path": "config.xml",
          "xpath": "/*[local-name()='widget' and namespace-uri()='http://www.w3.org/ns/widgets']/@version"
        }
      ]
    }
  }
}
