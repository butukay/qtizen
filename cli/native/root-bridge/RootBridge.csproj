<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><OutputType>Exe</OutputType><UseAppHost>false</UseAppHost>
    <AssemblyName>QtizenRootBridge</AssemblyName><DebugType>none</DebugType><Deterministic>true</Deterministic>
    <StartupObject>Qtizen.Root.BridgeProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../hdmi-wake/*.cs" Link="Hdmi/%(Filename)%(Extension)" />
    <Compile Include="../window-transitions/*.cs" Link="Transitions/%(Filename)%(Extension)" />
    <Compile Include="../root-common/*.cs" Link="Common/%(Filename)%(Extension)" />
    <Compile Include="../stremio-bridge/*.cs" Link="Stremio/%(Filename)%(Extension)" />
    <Compile Include="../untethered-probe/Bundle.cs" Link="Bundle.cs" />
    <Compile Include="../untethered-probe/ServiceLaunch.cs" Link="ServiceLaunch.cs" />
    <Compile Include="../untethered-probe/Probe.cs" Link="Probe.cs" />
    <Compile Include="../untethered-probe/PayloadRunner.cs" Link="PayloadRunner.cs" />
    <Compile Include="../untethered-probe/SdbProtocol.cs" Link="SdbProtocol.cs" />
  </ItemGroup>
</Project>
